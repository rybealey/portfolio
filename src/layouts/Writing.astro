---
// Shell for every /writing page: an intro, the feed column and the rail.
import Base from './Base.astro';
import WritingRail from '../components/writing/WritingRail.astro';
import type { Month } from '../lib/notes';

interface Props {
  title: string;
  description: string;
  image?: string | undefined;
  type?: 'website' | 'article' | undefined;
  months: Month[];
  currentMonth?: string | undefined;
}

const { title, description, image, type, months, currentMonth } = Astro.props;
---

<Base title={title} description={description} image={image} type={type}>
  <div class="page">
    <section class="intro">
      <slot name="intro" />
    </section>
    <div class="layout">
      <div class="feed">
        <slot />
      </div>
      <WritingRail months={months} currentMonth={currentMonth} />
    </div>
  </div>
</Base>

<style>
  .page { max-width: 1280px; margin: 0 auto; padding: 32px 40px 96px; display: flex; flex-direction: column; gap: 48px; }
  .intro { display: flex; flex-direction: column; gap: 20px; max-width: 760px; }
  .intro :global(.eyebrow) { margin: 0; display: flex; align-items: center; gap: 10px; color: var(--color-hud); }
  .intro :global(.eyebrow a) { color: inherit; text-decoration: none; }
  .intro :global(.eyebrow a:hover) { text-decoration: underline; }
  .intro :global(h1) {
    font-family: var(--font-display);
    font-weight: var(--type-display-weight);
    font-size: clamp(34px, 4vw, var(--type-display-size));
    line-height: 1.05;
    letter-spacing: var(--type-display-tracking);
    text-wrap: balance;
  }
  .intro :global(.lede) { margin: 0; font-size: var(--type-lede-size); line-height: var(--type-lede-line); text-wrap: pretty; }
  .layout { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 48px 24px; align-items: start; }
  .feed { grid-column: span 7; display: flex; flex-direction: column; min-width: 0; }
  .layout > :global(.rail) { grid-column: 9 / span 4; }
  @media (max-width: 1100px) {
    .feed { grid-column: span 8; }
    .layout > :global(.rail) { grid-column: span 4; }
  }
  @media (max-width: 860px) {
    .feed, .layout > :global(.rail) { grid-column: span 12; }
  }
  @media (max-width: 680px) {
    .page { padding: var(--space-16) var(--space-16) 64px; }
  }
</style>
