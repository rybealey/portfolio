---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Spectrum from '../components/Spectrum.astro';
import CommandPalette from '../components/CommandPalette.astro';
import ContactModal from '../components/ContactModal.astro';
import { site } from '../data/site';
import { cardFor, cardPath } from '../lib/og';

interface Props {
  title?: string;
  description?: string;
  /** A share image path (1200x630), e.g. a note's generated card. */
  image?: string | undefined;
  type?: 'website' | 'article' | undefined;
}

const { title, description = site.description, image, type = 'website' } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.lane}`;
// Clean URLs: no .html, no /index, no trailing slash.
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/(.)\/$/, '$1') || '/';
const canonical = new URL(cleanPath, site.url);
// A page without its own image gets a generated card (src/lib/og.ts); error
// pages and unknown paths get none.
const status = Astro.response.status ?? 200;
const card = image || status >= 400 ? undefined : await cardFor(cleanPath);
const shareImage = image ?? (card && cardPath(cleanPath, card));
const imageUrl = shareImage ? new URL(shareImage, site.url).href : undefined;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f6f4fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#140c22" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {
      imageUrl && (
        <>
          <meta property="og:image" content={imageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={imageUrl} />
        </>
      )
    }
    <link rel="alternate" type="application/rss+xml" title={`${site.name} · Writing`} href="/writing/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href="/fonts/atkinson-hyperlegible-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/unbounded-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        // Theme: the visitor's saved choice, else their system setting, else
        // light (the markup's default, which also covers no JavaScript).
        let saved = null;
        try {
          saved = localStorage.getItem('rb:theme');
        } catch {}
        try {
          if (saved === 'light' || saved === 'dark') root.dataset.theme = saved;
          else if (matchMedia('(prefers-color-scheme: dark)').matches) root.dataset.theme = 'dark';
        } catch {}
        try {
          if (!sessionStorage.getItem('rb:intro')) {
            sessionStorage.setItem('rb:intro', '1');
            root.dataset.intro = '';
          }
        } catch {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Spectrum />
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <CommandPalette />
    <ContactModal />
  </body>
</html>
