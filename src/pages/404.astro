---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
---

<Base title="Page not found">
  <div class="page">
    <PageIntro eyebrow="404" title="That page isn't here" lede="It may have moved, or it hasn't been written yet. Press ⌘K to jump anywhere on the site.">
      <p><a href="/">Back to home</a></p>
    </PageIntro>
  </div>
</Base>

<style>
  .page { max-width: 1280px; min-height: 50vh; margin: 0 auto; padding: 48px 40px 96px; }
  @media (max-width: 680px) {
    .page { padding: var(--space-24) var(--space-16) 64px; }
  }
</style>
