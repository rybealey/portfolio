---
// The one-page résumé that `npm run resume:pdf` prints to the PDF. It's built
// for applicant tracking systems as much as for people: one column, real
// text in reading order, standard section names, plain list bullets, and
// each job's title, employer and dates on one line. The page is kept out of
// search and the sitemap; /resume is the page to share.
import '../../styles/global.css';
import { site } from '../../data/site';
import { lanes, onePage } from '../../data/resume';

const host = new URL(site.url).host;
const contact = [
  { label: site.email, href: `mailto:${site.email}` },
  { label: host, href: site.url },
  { label: site.linkedin.replace(/^https:\/\/(www\.)?/, ''), href: site.linkedin },
  ...(site.github ? [{ label: site.github.replace(/^https:\/\//, ''), href: site.github }] : []),
];
const bands = ['pink', 'tangerine', 'lime', 'cyan', 'violet'];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="author" content={site.name} />
    <title>{site.name} Resume</title>
    <link rel="canonical" href={new URL('/resume', site.url)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="sheet">
      <div class="stripe" aria-hidden="true">{bands.map((band) => <span style={`background: var(--rv-${band})`} />)}</div>

      <header>
        <h1>{site.name}</h1>
        <p class="lanes">{lanes.map((lane) => lane.label).join(' · ')}</p>
        <p class="contact">
          {site.location}
          {
            contact.map((item) => (
              <>
                {' · '}
                <a href={item.href}>{item.label}</a>
              </>
            ))
          }
        </p>
      </header>

      <section>
        <h2>Summary</h2>
        <p>{onePage.summary}</p>
      </section>

      <section>
        <h2>Experience</h2>
        {
          onePage.experience.map((job) => (
            <article class="job">
              <h3 class="line">
                {job.title ? (
                  <>
                    <strong>{job.title}</strong>, {job.org}
                  </>
                ) : (
                  <strong>{job.org}</strong>
                )}
                <span class="muted">, {job.location} · {job.dates}</span>
              </h3>
              {job.bullets && (
                <ul>
                  {job.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              )}
              {job.roles?.map((role) => (
                <div class="role">
                  <h4 class="line">
                    <strong>{role.title}</strong>
                    <span class="muted"> · {role.dates}</span>
                  </h4>
                  {role.bullet && (
                    <ul>
                      <li>{role.bullet}</li>
                    </ul>
                  )}
                </div>
              ))}
            </article>
          ))
        }
      </section>

      <section>
        <h2>Projects</h2>
        <ul>
          {
            onePage.projects.map((project) => (
              <li>
                <strong>{project.name}:</strong> {project.text}
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Skills</h2>
        <ul>
          {
            onePage.skills.map((row) => (
              <li>
                <strong>{row.label}:</strong> {row.items}
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Education</h2>
        {
          onePage.education.map((item) => (
            <p class="line">
              <strong>{item.credential}</strong>, {item.school}
              <span class="muted"> · {item.year}</span>
            </p>
          ))
        }
      </section>
    </main>
  </body>
</html>

<style>
  /* One letter page. Plain text styles only: no letter-spacing, ligatures,
     drawn bullets or side-by-side columns, which some parsers read as stray
     spaces or symbols, or out of order. */
  @page { size: letter; margin: 0.45in 0.5in; }
  :global(html), :global(body) {
    background: #fff;
    color: #140c22;
    font-family: var(--font-body);
    font-size: 9.5pt;
    line-height: 1.28;
    font-variant-ligatures: none;
    min-height: 0;
  }
  .sheet { max-width: 7.5in; margin: 0 auto; }
  @media screen {
    .sheet { margin: 32px auto; padding: 0 16px; }
  }

  .stripe { display: flex; height: 4pt; margin-bottom: 8pt; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
  .stripe span { flex: 1; }

  header { padding-bottom: 6pt; border-bottom: 1.5pt solid #140c22; }
  h1 { font-family: var(--font-display); font-weight: 700; font-size: 20pt; line-height: 1.15; font-variant-ligatures: none; }
  .lanes { margin-top: 3pt; font-size: 10.5pt; font-weight: 700; }
  .contact { margin-top: 1pt; color: #4a3f5e; }
  a { color: inherit; text-decoration: none; }

  section { margin-top: 8pt; }
  h2 {
    margin-bottom: 3pt;
    padding-bottom: 2pt;
    border-bottom: 1px solid #c9c0d9;
    font-size: 10.5pt;
    line-height: 1.2;
    text-transform: uppercase;
    break-after: avoid;
  }
  h3, h4 { margin: 0; font-size: inherit; font-weight: 400; }
  strong { font-weight: 700; }
  .muted { color: #4a3f5e; }

  /* Title, employer and dates run on as one line of text. Right-aligned
     dates read well but layout-based parsers split them into a column of
     their own, away from the job they belong to. */
  .line { break-after: avoid; }
  .job + .job { margin-top: 6pt; }
  .role { margin-top: 2pt; }

  ul { margin: 2pt 0 0; padding-left: 13pt; list-style: disc; }
  li { padding-left: 1pt; }
  li + li { margin-top: 1.5pt; }
  li, p { break-inside: avoid; text-wrap: pretty; }
  li::marker { color: #140c22; }
</style>
