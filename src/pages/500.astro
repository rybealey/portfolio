---
// Shown when a page throws. Without it the server sends an empty 500, which
// reads as a white screen. The layout needs nothing from the database: the
// palette drops the case studies if they can't load.
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
---

<Base title="Something went wrong">
  <div class="page">
    <PageIntro eyebrow="500" title="This page didn't load" lede="Something broke on my end. Try again in a moment, or press ⌘K to jump anywhere on the site.">
      <p><a href="/">Back to home</a></p>
    </PageIntro>
  </div>
</Base>

<style>
  .page { max-width: 1280px; min-height: 50vh; margin: 0 auto; padding: 48px 40px 96px; }
  @media (max-width: 680px) {
    .page { padding: var(--space-24) var(--space-16) 64px; }
  }
</style>
