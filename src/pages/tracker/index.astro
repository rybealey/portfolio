---
// /tracker: Ry's job application tracker, behind a passcode. Never linked,
// listed in the sitemap or the ⌘K palette, cached or indexed. Locked, it shows
// only the passcode form; unlocked, it lists every role with filters and
// pages, and each row opens to its details and a small edit form. Data:
// src/lib/tracker.ts. Lock: src/lib/tracker-auth.ts.
//
// The filters are a plain GET form, so everything works without JavaScript.
// With it, a change re-renders only the results (#results) in place, and the
// URL follows along, so a filtered view can still be bookmarked.
import Base from '../../layouts/Base.astro';
import { PAGE_SIZES, LOCATIONS, SORTS, STATUSES, atsFamily, filterOptions, listApplications, parseFilters, statusCounts, type Status } from '../../lib/tracker';
import { PRIVATE_HEADERS, isUnlocked, trackerConfigured } from '../../lib/tracker-auth';

for (const [name, value] of Object.entries(PRIVATE_HEADERS)) Astro.response.headers.set(name, value);

const configured = trackerConfigured();
const unlocked = configured && isUnlocked(Astro.cookies);
const params = Astro.url.searchParams;
const lockMessage = { wrong: "That passcode didn't match.", limited: 'Too many wrong tries. Wait 15 minutes, then try again.', locked: 'Locked. This browser has forgotten the passcode.' }[params.get('e') ?? ''];

const DEFAULT_SORT = 'recent';
const DEFAULT_PER_PAGE = 50;
const filters = parseFilters(params, false, { perPage: DEFAULT_PER_PAGE });
const result = unlocked ? await listApplications(filters) : undefined;
const counts = unlocked ? await statusCounts() : undefined;
const options = unlocked ? await filterOptions() : undefined;
const total = counts ? Object.values(counts).reduce((a, b) => a + b, 0) : 0;

// Links keep every other filter and reset the page unless told otherwise.
const href = (changes: Record<string, string | string[] | undefined>, keepPage = false) => {
  const next = new URLSearchParams();
  for (const [key, value] of params) if (value && !['notice', 'row', 'e'].includes(key)) next.append(key, value);
  if (!keepPage) next.delete('page');
  for (const [key, value] of Object.entries(changes)) {
    next.delete(key);
    for (const v of [value].flat()) if (v) next.append(key, v);
  }
  const query = next.toString();
  return query ? `/tracker?${query}` : '/tracker';
};
const pageHref = (page: number) => href({ page: page > 1 ? String(page) : undefined }, true);
const returnTo = href({}, true);

// Page numbers: the first, the last, and two either side of the current one.
const pageList = (() => {
  if (!result) return [];
  const { page, pages } = result;
  const wanted = [...new Set([1, pages, page - 2, page - 1, page, page + 1, page + 2])].filter((n) => n >= 1 && n <= pages).sort((a, b) => a - b);
  const out: (number | 'gap')[] = [];
  wanted.forEach((n, i) => {
    if (i && n - wanted[i - 1]! > 1) out.push('gap');
    out.push(n);
  });
  return out;
})();

// Filters in effect, each with a link that removes it.
const active: { label: string; remove: string }[] = [];
if (filters.q) active.push({ label: `“${filters.q}”`, remove: href({ q: undefined }) });
for (const s of filters.statuses ?? []) active.push({ label: s, remove: href({ status: (filters.statuses ?? []).filter((x) => x !== s) }) });
if (filters.location) active.push({ label: LOCATIONS[filters.location].label, remove: href({ location: undefined }) });
if (filters.tier) active.push({ label: `Tier ${filters.tier}`, remove: href({ tier: undefined }) });
if (filters.ats) active.push({ label: `Via ${filters.ats}`, remove: href({ ats: undefined }) });
if (filters.found) active.push({ label: filters.found, remove: href({ found: undefined }) });
if (filters.appliedFrom) active.push({ label: `From ${filters.appliedFrom}`, remove: href({ appliedFrom: undefined }) });
if (filters.appliedTo) active.push({ label: `To ${filters.appliedTo}`, remove: href({ appliedTo: undefined }) });
// The secondary filters live under "More filters"; it opens when one is set.
const moreCount = [filters.tier, filters.ats, filters.found, filters.appliedFrom || filters.appliedTo].filter(Boolean).length;

const tone = (status: Status) =>
  ({ Interviewing: 'success', Offer: 'success', 'Needs you': 'warning', Rejected: 'quiet', Withdrawn: 'quiet', Skipped: 'quiet' })[status as string] ?? 'plain';

const notice = params.get('notice');
const noticeRow = params.get('row');
const noticeText = { saved: 'Saved.', conflict: 'That row changed since this page loaded, so nothing was saved. Reload and try again.', missing: 'That row no longer exists.', failed: "Couldn't save that change. Try again." }[notice ?? ''];
const fmt = (n: number) => n.toLocaleString('en-US');
const first = result && result.total ? (result.page - 1) * result.perPage + 1 : 0;
const last = result ? Math.min(result.page * result.perPage, result.total) : 0;
const statusesShown = counts ? STATUSES.filter((s) => counts[s] > 0 || filters.statuses?.includes(s)) : [];
---

<Base title="Job tracker" description="Private." noindex>
  <div class="page">
    {
      !unlocked ? (
        <section class="lock" aria-labelledby="lock-title">
          <p class="hud eyebrow">Private</p>
          <h1 id="lock-title">Job tracker</h1>
          {configured ? (
            <form method="post" action="/tracker/unlock" class="lock-form">
              <label for="passcode">Passcode</label>
              <div class="row">
                <input id="passcode" name="passcode" type="password" autocomplete="current-password" maxlength="200" required autofocus aria-describedby={lockMessage ? 'lock-message' : undefined} />
                <button class="btn btn-primary" type="submit">Unlock</button>
              </div>
              {lockMessage && <p id="lock-message" class="message" role="alert">{lockMessage}</p>}
            </form>
          ) : (
            <p class="muted">This page isn't set up on this server.</p>
          )}
        </section>
      ) : (
        <>
          <header class="head">
            <div>
              <p class="hud eyebrow">Private</p>
              <h1>Job tracker</h1>
              <p class="muted">{fmt(total)} roles researched or applied to.</p>
            </div>
            <form method="post" action="/tracker/lock">
              <button class="btn btn-ghost btn-sm" type="submit">Lock</button>
            </form>
          </header>

          {noticeText && (
            <p class:list={['notice', notice === 'saved' ? 'ok' : 'warn']} role="status">
              {noticeText} {noticeRow && <a href={`#row-${noticeRow}`}>Go to the row</a>}
            </p>
          )}

          <details class="filter-box" open data-filters={active.length ? 'active' : 'none'}>
            <summary class="filter-toggle">
              Filters {active.length > 0 && <span class="hud badge">{active.length} on</span>}
            </summary>
            <form method="get" action="/tracker" class="filters" id="filters" role="search" aria-label="Filter roles">
              <div class="search">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
                <label class="sr-only" for="f-q">Search roles</label>
                <input id="f-q" name="q" type="search" value={filters.q ?? ''} placeholder="Search company, role, location or notes" maxlength="200" autocomplete="off" enterkeyhint="search" />
                <span class="hud key" aria-hidden="true">Enter</span>
              </div>

              <fieldset class="group">
                <legend class="hud group-label">Status <span class="hint">any of</span></legend>
                <div class="pills">
                  {statusesShown.map((s) => (
                    <label class:list={['pill', tone(s)]}>
                      <input type="checkbox" name="status" value={s} checked={filters.statuses?.includes(s)} />
                      <span class="pill-face">
                        <svg class="tick" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"></path></svg>
                        {s} <span class="count">{fmt(counts![s])}</span>
                      </span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <fieldset class="group">
                <legend class="hud group-label">Location</legend>
                <div class="segmented">
                  <label class="seg">
                    <input type="radio" name="location" value="" checked={!filters.location} />
                    <span>Anywhere</span>
                  </label>
                  {Object.entries(LOCATIONS).map(([key, l]) => (
                    <label class="seg">
                      <input type="radio" name="location" value={key} checked={filters.location === key} />
                      <span>{l.label}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <details class="more" open={moreCount > 0}>
                <summary>
                  <svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
                  More filters {moreCount > 0 && <span class="hud badge">{moreCount} on</span>}
                </summary>
                <div class="more-grid">
                  <fieldset class="group">
                    <legend class="hud group-label">Tier</legend>
                    <div class="segmented">
                      <label class="seg">
                        <input type="radio" name="tier" value="" checked={!filters.tier} />
                        <span>Any</span>
                      </label>
                      {options!.tiers.map((t) => (
                        <label class="seg" title={`${fmt(t.count)} roles`}>
                          <input type="radio" name="tier" value={t.value} checked={filters.tier === t.value} aria-label={`Tier ${t.value}, ${fmt(t.count)} roles`} />
                          <span aria-hidden="true">{t.value}</span>
                        </label>
                      ))}
                    </div>
                  </fieldset>
                  <div class="field">
                    <label class="hud group-label" for="f-ats">Applied through</label>
                    <div class="select">
                      <select id="f-ats" name="ats">
                        <option value="">Any platform</option>
                        {options!.ats.map((a) => <option value={a.value} selected={filters.ats === a.value}>{a.value} ({fmt(a.count)})</option>)}
                      </select>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
                    </div>
                  </div>
                  <div class="field">
                    <label class="hud group-label" for="f-found">Found through</label>
                    <div class="select">
                      <select id="f-found" name="found">
                        <option value="">Any source</option>
                        {options!.found.map((f) => <option value={f.value} selected={filters.found === f.value}>{f.value} ({fmt(f.count)})</option>)}
                      </select>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
                    </div>
                  </div>
                  <fieldset class="group wide">
                    <legend class="hud group-label">Applied between</legend>
                    <div class="range">
                      <label class="sr-only" for="f-from">Applied on or after</label>
                      <input id="f-from" name="appliedFrom" type="date" value={filters.appliedFrom ?? ''} />
                      <span class="muted" aria-hidden="true">to</span>
                      <label class="sr-only" for="f-to">Applied on or before</label>
                      <input id="f-to" name="appliedTo" type="date" value={filters.appliedTo ?? ''} />
                    </div>
                  </fieldset>
                </div>
              </details>

              <div class="actions">
                <button class="btn btn-primary btn-sm" type="submit">Apply filters</button>
                {active.length > 0 && <a class="btn btn-ghost btn-sm" href="/tracker">Clear all</a>}
              </div>
            </form>
          </details>

          <div id="results" class="results">
            <div class="toolbar">
              <p class="summary" role="status" aria-live="polite">
                {result!.total ? (
                  <>
                    <strong>{fmt(first)} to {fmt(last)}</strong> of {fmt(result!.total)} {result!.total === 1 ? 'role' : 'roles'}
                  </>
                ) : (
                  'No roles match these filters.'
                )}
              </p>
              <div class="sorters">
                <label class="inline">
                  <span class="hud group-label">Sort</span>
                  <span class="select compact">
                    <select name="sort" form="filters">
                      {Object.entries(SORTS).map(([key, s]) => <option value={key} selected={(filters.sort ?? DEFAULT_SORT) === key}>{s.label}</option>)}
                    </select>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </label>
                <label class="inline">
                  <span class="hud group-label">Show</span>
                  <span class="select compact">
                    <select name="perPage" form="filters">
                      {PAGE_SIZES.map((n) => <option value={n} selected={result!.perPage === n}>{n}</option>)}
                    </select>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
                  </span>
                </label>
              </div>
            </div>

            {active.length > 0 && (
              <div class="active">
                <ul aria-label="Filters in use">
                  {active.map((f) => (
                    <li>
                      <a class="hud chip" href={f.remove} data-sync aria-label={`Remove filter: ${f.label}`}>
                        {f.label}
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                      </a>
                    </li>
                  ))}
                </ul>
                <a class="clear" href="/tracker" data-sync>Clear all</a>
              </div>
            )}

            <ol class="rows" start={first || undefined}>
              {result!.applications.map((a) => (
                <li id={`row-${a.slug}`}>
                  <details open={noticeRow === a.slug && notice !== 'saved' ? true : undefined}>
                    <summary>
                      <span class="who">
                        <strong>{a.company}</strong>
                        <span>{a.role}</span>
                      </span>
                      <span class:list={['hud', 'chip', 'status', tone(a.status)]}>{a.status}</span>
                      <span class="meta">{a.appliedOn ?? 'Not applied'}</span>
                      <span class="meta where">{a.location ?? 'Location not listed'}</span>
                    </summary>
                    <div class="detail">
                      <dl>
                        {a.why && (<><dt>Why it fits</dt><dd>{a.why}</dd></>)}
                        {a.experience && (<><dt>What they want</dt><dd>{a.experience}</dd></>)}
                        {a.pay && (<><dt>Pay</dt><dd>{a.pay}</dd></>)}
                        <dt>Applied through</dt><dd>{a.ats ?? 'Not recorded'} <span class="muted">({atsFamily(a.ats)})</span></dd>
                        {a.found && (<><dt>Found through</dt><dd>{a.found}</dd></>)}
                        {(a.tier || a.rank) && (<><dt>Tier and rank</dt><dd>{a.tier ? `Tier ${a.tier}` : 'No tier'}{a.rank ? ` · rank ${a.rank}` : ''}</dd></>)}
                        {a.notes && (<><dt>Notes</dt><dd class="notes">{a.notes}</dd></>)}
                        {a.url && (<><dt>Posting</dt><dd><a href={a.url} rel="noopener noreferrer" target="_blank">{new URL(a.url).host}</a></dd></>)}
                      </dl>
                      <form method="post" action={`/tracker/applications/${a.slug}`} class="edit">
                        <input type="hidden" name="version" value={a.version} />
                        <input type="hidden" name="current" value={a.status} />
                        <input type="hidden" name="return" value={returnTo} />
                        <div class="field">
                          <label for={`s-${a.slug}`}>Status</label>
                          <span class="select">
                            <select id={`s-${a.slug}`} name="status">
                              {STATUSES.map((s) => <option value={s} selected={a.status === s}>{s}</option>)}
                            </select>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
                          </span>
                        </div>
                        <div class="field grow">
                          <label for={`n-${a.slug}`}>Add a note</label>
                          <textarea id={`n-${a.slug}`} name="note" rows="2" maxlength="5000" placeholder="Dated automatically"></textarea>
                        </div>
                        <button class="btn btn-primary btn-sm" type="submit">Save</button>
                      </form>
                      <p class="caption">Updated {new Date(a.updatedAt).toLocaleString('en-US', { timeZone: 'America/Chicago', dateStyle: 'medium', timeStyle: 'short' })} · version {a.version}</p>
                    </div>
                  </details>
                </li>
              ))}
            </ol>

            {result!.pages > 1 && (
              <nav class="pager" aria-label="Pages">
                {result!.page > 1 ? <a href={pageHref(result!.page - 1)} rel="prev" data-page>Previous</a> : <span aria-disabled="true">Previous</span>}
                <ul>
                  {pageList.map((p) =>
                    p === 'gap' ? (
                      <li aria-hidden="true">…</li>
                    ) : (
                      <li>
                        <a href={pageHref(p)} aria-current={p === result!.page ? 'page' : undefined} aria-label={`Page ${p}`} data-page>{p}</a>
                      </li>
                    ),
                  )}
                </ul>
                {result!.page < result!.pages ? <a href={pageHref(result!.page + 1)} rel="next" data-page>Next</a> : <span aria-disabled="true">Next</span>}
              </nav>
            )}
          </div>
        </>
      )
    }
  </div>
</Base>

<script>
  // Progressive enhancement for the filters: re-render the results in place
  // as filters change, keep the URL in step, and fold the filters away on a
  // phone until they're wanted. Without JavaScript the form submits as usual.
  const box = document.querySelector<HTMLDetailsElement>('.filter-box');
  if (box && box.dataset['filters'] === 'none' && matchMedia('(max-width: 760px)').matches) box.open = false;

  const form = document.querySelector<HTMLFormElement>('#filters');
  const results = document.querySelector<HTMLElement>('#results');
  if (form && results) {
    form.classList.add('live');
    const DEFAULTS: Record<string, string> = { sort: 'recent', perPage: '50' };
    let timer: number | undefined;
    let controller: AbortController | undefined;

    const urlFromForm = () => {
      const next = new URLSearchParams();
      for (const [key, value] of new FormData(form)) {
        const v = String(value).trim();
        if (v && DEFAULTS[key] !== v) next.append(key, v);
      }
      const query = next.toString();
      return query ? `/tracker?${query}` : '/tracker';
    };

    // syncForm: also replace the form (for chip, pager and clear links, whose
    // URL the form doesn't know yet). Typing never replaces the form, so the
    // search box keeps focus.
    const load = async (url: string, { syncForm = false, scroll = false } = {}) => {
      controller?.abort();
      controller = new AbortController();
      results.setAttribute('aria-busy', 'true');
      try {
        const res = await fetch(url, { signal: controller.signal, credentials: 'same-origin' });
        const html = await res.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const next = doc.querySelector('#results');
        if (!res.ok || !next) return void (location.href = url);
        results.innerHTML = next.innerHTML;
        const nextForm = doc.querySelector('#filters');
        if (syncForm && nextForm) form.innerHTML = nextForm.innerHTML;
        const toggle = doc.querySelector('.filter-toggle');
        const here = document.querySelector('.filter-toggle');
        if (toggle && here) here.innerHTML = toggle.innerHTML;
        if (!syncForm && nextForm) {
          const badge = nextForm.querySelector('.more summary');
          const mine = form.querySelector('.more summary');
          if (badge && mine) mine.innerHTML = badge.innerHTML;
        }
        history.replaceState(null, '', url);
        if (scroll) results.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      } catch (error) {
        if ((error as Error).name !== 'AbortError') location.href = url;
      } finally {
        results.removeAttribute('aria-busy');
      }
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      window.clearTimeout(timer);
      load(urlFromForm());
    });
    form.addEventListener('change', (event) => {
      if ((event.target as HTMLInputElement).name === 'q') return;
      load(urlFromForm());
    });
    form.addEventListener('input', (event) => {
      if ((event.target as HTMLInputElement).name !== 'q') return;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => load(urlFromForm()), 350);
    });
    // Sort and page size sit in the results toolbar but belong to the form.
    results.addEventListener('change', (event) => {
      if ((event.target as HTMLSelectElement).form === form) load(urlFromForm());
    });
    results.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[data-sync], a[data-page]');
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      load(link.href, { syncForm: link.hasAttribute('data-sync'), scroll: link.hasAttribute('data-page') });
    });
    form.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href="/tracker"]');
      if (!link) return;
      event.preventDefault();
      load('/tracker', { syncForm: true });
    });
  }
</script>

<style>
  .page { max-width: 1280px; min-height: 50vh; margin: 0 auto; padding: 48px 40px 96px; display: flex; flex-direction: column; gap: var(--space-24); }
  .eyebrow { color: var(--color-hud); }
  h1 { font-family: var(--font-display); font-weight: var(--type-display-weight); font-size: clamp(32px, 5vw, var(--type-display-size)); line-height: 1.05; letter-spacing: var(--type-display-tracking); }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  button.btn { border: 0; cursor: pointer; font: inherit; font-weight: 700; }
  button.btn-ghost { background: transparent; border: 2px solid var(--color-ink-muted); }

  .lock { max-width: 480px; display: flex; flex-direction: column; gap: 16px; }
  .lock-form { display: flex; flex-direction: column; gap: 8px; }
  .lock-form .row { display: flex; gap: 12px; flex-wrap: wrap; }
  .lock-form input { flex: 1 1 220px; min-height: 48px; padding: 0 14px; font: inherit; font-size: 16px; color: var(--color-ink); background: var(--color-bg); border: 2px solid var(--color-ink-muted); border-radius: var(--radius-sm); }
  .lock-form input:focus { outline: none; border-color: var(--color-focus); }
  .message { color: var(--color-warning); font-weight: 700; }

  .head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; }
  .head > div { display: flex; flex-direction: column; gap: 8px; }

  .notice { padding: 12px 16px; border-radius: var(--radius-sm); border: 2px solid currentColor; font-weight: 700; }
  .notice.ok { color: var(--color-success); }
  .notice.warn { color: var(--color-warning); }

  /* Filter panel ------------------------------------------------------------ */
  .filter-box { display: flex; flex-direction: column; gap: 12px; }
  .filter-toggle { width: fit-content; min-height: 44px; display: none; align-items: center; gap: 10px; font-weight: 700; cursor: pointer; list-style: none; }
  .filter-toggle::-webkit-details-marker { display: none; }
  .badge { padding: 2px 8px; border: 1px solid currentColor; border-radius: var(--radius-sm); color: var(--color-hud); }

  .filters {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: var(--space-24);
    background: var(--color-panel);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
  }
  .group { display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0; border: 0; min-width: 0; }
  .group-label { color: var(--color-ink-muted); padding: 0; }
  .hint { text-transform: none; letter-spacing: 0; font-family: var(--font-body); font-weight: 400; font-size: 13px; }

  /* Search, in the command palette's style. */
  .search {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 0 14px 0 16px;
