---
import { getCaseStudies } from '../lib/work';
import Base from '../layouts/Base.astro';
import BentoGrid from '../components/bento/BentoGrid.astro';
import BentoCell from '../components/bento/BentoCell.astro';
import HeroTile from '../components/tiles/HeroTile.astro';
import CaseTile from '../components/tiles/CaseTile.astro';
import SpotifyTile from '../components/tiles/SpotifyTile.astro';
import ClockTile from '../components/tiles/ClockTile.astro';
import FactTile from '../components/tiles/FactTile.astro';
import ContactTile from '../components/tiles/ContactTile.astro';
import { site } from '../data/site';
import { formatUpdated, lastUpdated } from '../lib/updated';

// Case studies come and go from Publisher, so the grid takes however many are
// published: the first gets the tall tile, the rest get half tiles, and with
// none the small tiles fill in beside the hero.
const [featured, ...studies] = await getCaseStudies();
// Three case studies leave every row of the 12-column grid full. Any other
// count leaves the last row 4 or 8 columns short, so the Apple tile widens to
// close the gap. Counted in grid cells: the tall tile covers 8, a half 4.
const caseCells = featured ? 8 + 4 * studies.length : 0;
const shortBy = (((4 - caseCells) % 12) + 12) % 12;
const appleSize = shortBy === 0 ? 'half' : shortBy === 4 ? 'wide' : 'full';

const updatedAt = await lastUpdated();
const updated = updatedAt ? formatUpdated(updatedAt) : 'Recently';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: 'Product and Operations Lead',
  worksFor: { '@type': 'Organization', name: 'SERVERIZZ', url: 'https://serverizz.com' },
  description: site.description,
  homeLocation: { '@type': 'Place', name: site.location },
  sameAs: [site.linkedin, ...(site.github ? [site.github] : [])],
};
---

<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <div class="page">
    <h2 class="visually-hidden" id="work">Work and highlights</h2>
    <BentoGrid>
      {/* DOM order is the phone read order: hero, case studies, live tiles, about, contact. */}
      <BentoCell id="hero" size="hero"><HeroTile /></BentoCell>
      {featured && <BentoCell id={`case-${featured.id}`} size="feature"><CaseTile entry={featured} featured /></BentoCell>}
      {studies.map((entry) => <BentoCell id={`case-${entry.id}`} size="half"><CaseTile entry={entry} /></BentoCell>)}

      <BentoCell id="spotify" size="small" movable name="Spotify"><SpotifyTile /></BentoCell>
      <BentoCell id="home-base" size="small" movable name="Home base"><ClockTile /></BentoCell>
      <BentoCell id="now" size="small" movable name="Now">
        <FactTile href="/about" label="Now" title="Product and Operations Lead" caption="SERVERIZZ, Austin" />
      </BentoCell>
      <BentoCell id="updated" size="small" movable name="Updated">
        <FactTile href="/colophon" label="Updated" title={updated} caption="How this site is built" />
      </BentoCell>
      <BentoCell id="apple" size={appleSize} movable name="Apple">
        <FactTile
          href="/about"
          label="Apple · since 2018"
          neutral
          titleStyle="heading"
          title="Eight years on Apple's front line"
          caption="Sales chat, AppleCare support, knowledge management and community moderation."
        />
      </BentoCell>
      <BentoCell id="impeccabyte" size="small" movable name="Impeccabyte">
        <FactTile href="/about" label="Payments" neutral titleStyle="name" title="Impeccabyte" caption="My merchant services agency" />
      </BentoCell>
      <BentoCell id="ryvanse" size="small" movable name="Ryvanse">
        <FactTile href="/about" label="Design" neutral titleStyle="name" title="Ryvanse" caption="My streaming brand, where this look started" />
      </BentoCell>

      <BentoCell id="contact" size="full"><ContactTile /></BentoCell>
    </BentoGrid>
  </div>
</Base>

<style>
  .page { max-width: 1280px; margin: 0 auto; padding: var(--space-16) 40px 48px; }
  @media (max-width: 680px) {
    .page { padding: var(--space-8) var(--space-16) 40px; }
  }
</style>
