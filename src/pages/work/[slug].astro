---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import { getCaseStudy } from '../../lib/work';
import { renderMarkdown } from '../../lib/markdown';

const entry = await getCaseStudy(Astro.params.slug ?? '');
if (!entry) return Astro.rewrite('/404');
const { number, label, title, summary, status, accent, metrics } = entry.data;
const html = await renderMarkdown(entry.body);
const statusChip = {
  shipped: { label: 'Shipped', tone: 'success' },
  live: { label: 'Live', tone: 'success' },
  phased: { label: 'Live · phased rollout', tone: 'success' },
  prototype: { label: 'Prototype', tone: 'warning' },
  'in-progress': { label: 'Write-up in progress', tone: 'warning' },
} as const;
---

<Base title={title} description={summary}>
  <article class="page" style={`--accent: var(--color-accent-${accent})`}>
    {/* Shares the home tile's transition name, so the tile morphs into this header. */}
    <div class="morph" style={`view-transition-name: case-${entry.id}; view-transition-class: case`}>
    <PageIntro eyebrow={`${number} · ${label}`} title={title} lede={summary} status={statusChip[status]}>
      <ul role="list" class="metrics" aria-label="Highlights">
        {metrics.map((metric) => <li class="hud chip">{metric}</li>)}
      </ul>
    </PageIntro>
    </div>
    <div class="body">
      <Fragment set:html={html} />
      <p><a href="/">Back to home</a></p>
    </div>
  </article>
</Base>

<style>
  .page { max-width: 1280px; min-height: 50vh; margin: 0 auto; padding: 48px 40px 96px; display: flex; flex-direction: column; gap: 40px; }
  .metrics { display: flex; flex-wrap: wrap; gap: var(--space-8); }
  .metrics .chip { color: var(--accent); }
  .body { max-width: 760px; display: flex; flex-direction: column; gap: var(--space-16); color: var(--color-ink-muted); }
  @media (max-width: 680px) {
    .page { padding: var(--space-24) var(--space-16) 64px; }
  }
</style>
