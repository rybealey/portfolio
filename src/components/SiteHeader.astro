---
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
// '/' only matches the home page itself; other entries match their section.
const isCurrent = (item: (typeof nav)[number]) =>
  ('match' in item ? item.match : [item.href]).some((base) => (base === '/' ? path === '/' : path.startsWith(base)));
const resumeHref = site.resumePdf ?? '/resume';
---

<header class="site-header">
  <a class="wordmark" href="/">{site.name}</a>
  <nav aria-label="Primary" class="primary">
    <ul role="list" class="links" id="primary-links">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="links-resume"><a href={resumeHref}>Resume</a></li>
    </ul>
    <button type="button" class="icon-btn" data-theme-toggle aria-label="Switch to light mode">
      <Icon name="sun" class="when-dark" />
      <Icon name="moon" class="when-light" />
    </button>
    <button type="button" class="icon-btn hud" data-cmdk-open aria-label="Open command palette" aria-keyshortcuts="Meta+K Control+K">
      <Icon name="search" size={16} />
      <span class="cmdk-hint" aria-hidden="true">⌘K</span>
    </button>
    <button type="button" class="icon-btn menu-btn" aria-expanded="false" aria-controls="primary-links" data-menu-toggle>
      <span class="visually-hidden">Menu</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
    <a class="btn btn-primary btn-sm resume-btn" href={resumeHref}>Resume</a>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const sync = () => {
    const light = root.dataset.theme === 'light';
    toggle?.setAttribute('aria-label', light ? 'Switch to dark mode' : 'Switch to light mode');
  };
  sync();

  // "Sunrise" switch: the new theme fades in over the old one, slowly when
  // brightening (the jump to light is what stings) and quickly when dimming.
  // data-theme-to tells the CSS in global.css which timing to use. Browsers
  // without View Transitions fade colors instead; reduced motion is instant.
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const FALLBACK_MS = { light: 600, dark: 250 } as const;
  let fallbackTimer: number | undefined;

  const applyTheme = (next: 'light' | 'dark') => {
    if (root.dataset.theme === next) return;
    const set = () => {
      root.dataset.theme = next;
      sync();
    };
    if (reducedMotion.matches) return set();

    root.dataset.themeTo = next;
    if (document.startViewTransition) {
      document.startViewTransition(set).finished.finally(() => delete root.dataset.themeTo);
      return;
    }
    clearTimeout(fallbackTimer);
    root.classList.add('theme-fading');
    set();
    fallbackTimer = window.setTimeout(() => {
      root.classList.remove('theme-fading');
      delete root.dataset.themeTo;
    }, FALLBACK_MS[next]);
  };

  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    try {
      localStorage.setItem('rb:theme', next);
    } catch {}
    applyTheme(next);
  });

  // Until the visitor picks a theme, follow their system setting live.
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    let saved = null;
    try {
      saved = localStorage.getItem('rb:theme');
    } catch {}
    if (!saved) applyTheme(event.matches ? 'dark' : 'light');
  });

  const menu = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  menu?.addEventListener('click', () => {
    const open = menu.getAttribute('aria-expanded') !== 'true';
    menu.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .site-header {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    padding: var(--space-24) 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-24);
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    line-height: 24px;
    color: var(--color-ink);
    text-decoration: none;
  }
  .primary { display: flex; align-items: center; gap: var(--space-16); }
  .links { display: flex; align-items: center; gap: var(--space-24); padding-right: var(--space-8); font-weight: 700; }
  .links a { color: var(--color-ink-muted); text-decoration: none; }
  .links a:hover { color: var(--color-ink); }
  .links a[aria-current='page'] { color: var(--color-ink); text-decoration: underline 3px var(--rv-pink); text-underline-offset: 8px; }
  .links-resume, .menu-btn { display: none; }

  :global([data-theme='light']) .icon-btn[data-cmdk-open] { background: var(--color-panel); }
  /* The icons render inside Icon.astro, outside this component's scope. */
  :global(.when-light) { display: none; }
  :global([data-theme='light'] .when-light) { display: block; }
  :global([data-theme='light'] .when-dark) { display: none; }

  @media (max-width: 680px) {
    .site-header { padding: 12px var(--space-16); }
    .wordmark { font-size: 18px; }
    .primary { gap: var(--space-8); }
    .cmdk-hint, .resume-btn { display: none; }
    .menu-btn { display: inline-flex; color: var(--color-ink); }
    .links {
      display: none;
      position: absolute;
      top: 100%;
      left: var(--space-16);
      right: var(--space-16);
      z-index: 20;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-8);
      background: var(--color-panel);
      border: 2px solid var(--color-ink-muted);
      border-radius: 12px;
      box-shadow: 4px 4px 0 0 var(--color-pop);
    }
    .links a { display: flex; align-items: center; min-height: 44px; padding: 0 12px; }
    .links-resume { display: block; }
    .primary:has([aria-expanded='true']) .links { display: flex; }
  }
</style>
