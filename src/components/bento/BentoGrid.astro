---
import Icon from '../Icon.astro';
---

<div class="bento-wrap">
  <p id="bento-help" class="visually-hidden">
    Press Space to pick the tile up, arrow keys to move it, and Space again to drop it. Escape cancels.
  </p>
  <div class="bento" data-bento>
    <slot />
  </div>
  <script is:inline>
    // Restore a saved order before first paint so the grid never jumps.
    // Touch devices can't rearrange, so they always get the designed order.
    (() => {
      try {
        if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
        const grid = document.querySelector('[data-bento]');
        const cells = [...grid.querySelectorAll(':scope > [data-movable]')];
        grid.dataset.defaultOrder = JSON.stringify(cells.map((c) => c.dataset.tileId));
        const byId = new Map(cells.map((c) => [c.dataset.tileId, c]));
        const saved = JSON.parse(localStorage.getItem('rb:bento') || 'null');
        if (!Array.isArray(saved) || saved.length !== cells.length || !saved.every((id) => byId.has(id))) return;
        const slots = cells.map((c) => {
          const marker = document.createComment('');
          c.replaceWith(marker);
          return marker;
        });
        slots.forEach((marker, i) => marker.replaceWith(byId.get(saved[i])));
      } catch {}
    })();
  </script>
  <div class="bento-tools">
    <button type="button" class="reset hud" data-bento-reset hidden>
      <Icon name="reset" size={14} />
      Reset layout
    </button>
  </div>
  <p class="visually-hidden" aria-live="assertive" data-bento-live></p>
</div>

<script>
  import { initBento } from '../../lib/bento';

  const grid = document.querySelector<HTMLElement>('[data-bento]');
  if (grid) initBento(grid);
</script>

<style>
  .bento {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: minmax(196px, auto);
    grid-auto-flow: row dense;
    gap: var(--space-24);
  }

  .bento :global(.cell) { position: relative; min-width: 0; container-type: inline-size; }
  .bento :global(.size-hero) { grid-column: span 8; grid-row: span 2; }
  .bento :global(.size-feature) { grid-column: span 4; grid-row: span 2; }
  .bento :global(.size-half) { grid-column: span 4; }
  .bento :global(.size-small) { grid-column: span 2; }
  .bento :global(.size-small > .tile:not(.spotify)) { padding: 20px; }
  .bento :global(.size-full) { grid-column: 1 / -1; }

  /* Rearranging is a mouse and keyboard feature; touch devices get the
     designed layout and no handles. Matches CAN_REARRANGE in lib/bento.ts. */
  .bento :global(.grip) { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .bento :global([data-movable]) { -webkit-user-select: none; user-select: none; }
    .bento :global([data-movable] > .tile) { cursor: grab; }
    .bento :global(.grip) { display: grid; }
  }
  .bento :global(.grip) {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 2;
    width: 32px;
    height: 32px;
    place-items: center;
    padding: 0;
    background: var(--color-bg);
    color: var(--color-ink-muted);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    cursor: grab;
    opacity: 0;
    transition: opacity 120ms;
  }
  /* Extend the hit area to 44px without growing the visual handle. */
  .bento :global(.grip)::after { content: ''; position: absolute; inset: -6px; }
  .bento :global([data-movable]:hover .grip),
  .bento :global(.grip:focus-visible),
  .bento :global(.grip[aria-pressed='true']) { opacity: 1; }

  .bento :global(.is-dragging) { z-index: 10; will-change: transform; }
  .bento :global(.is-dragging > .tile),
  .bento :global(.is-picked > .tile) {
    cursor: grabbing;
    box-shadow: 4px 4px 0 0 var(--color-pop);
    border-color: var(--color-ink-muted);
  }
  .bento :global(.is-dragging > .tile) { transform: rotate(-1.5deg) scale(1.03); }
  .bento :global(.is-picked > .tile) { transform: translateY(-2px); outline: 2px dashed var(--color-focus); outline-offset: 4px; }

  .bento :global(.drop-slot) {
    position: absolute;
    z-index: 0;
    border: 2px dashed var(--color-ink-muted);
    border-radius: var(--radius-md);
    pointer-events: none;
    transition: all 180ms cubic-bezier(0.3, 1.3, 0.6, 1);
  }

  .bento-tools { display: flex; align-items: center; justify-content: flex-end; min-height: 44px; margin-top: var(--space-8); }
  .reset {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-height: 44px;
    padding: 0 12px;
    background: transparent;
    color: var(--color-ink-muted);
    border: 0;
    cursor: pointer;
  }
  .reset:hover { color: var(--color-ink); }
  .reset[hidden] { display: none; }

  @media (max-width: 1100px) {
    .bento { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .bento :global(.size-hero) { grid-column: span 6; }
    .bento :global(.size-feature),
    .bento :global(.size-half),
    .bento :global(.size-small) { grid-column: span 3; }
  }

  @media (max-width: 680px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: auto; gap: var(--space-16); }
    .bento :global(.size-hero),
    .bento :global(.size-feature),
    .bento :global(.size-half),
    .bento :global(.size-full) { grid-column: 1 / -1; grid-row: auto; }
    .bento :global(.size-small) { grid-column: span 1; }
    .bento :global(.size-small > .tile:not(.spotify)) { padding: var(--space-16); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bento :global(.is-dragging > .tile) { transform: none; }
    .bento :global(.drop-slot) { transition: none; }
  }
</style>
