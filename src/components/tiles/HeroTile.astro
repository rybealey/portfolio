---
import Icon from '../Icon.astro';
import { site } from '../../data/site';

const bands = ['pink', 'tangerine', 'lime', 'cyan', 'violet'];
const resumeIsPdf = Boolean(site.resumePdf);
---

<section class="tile hero theme-dark" aria-labelledby="hero-name">
  <div class="copy">
    <p class="hud tile-label">{site.lane} · {site.location}</p>
    <h1 id="hero-name">{site.name}</h1>
    <p class="lede">I turn web, infrastructure and payments problems into specs, data models and working software, with AI as my build partner.</p>
    <p class="muted">Product and operations at SERVERIZZ since 2014. Eight years on Apple's front line.</p>
  </div>
  <div class="actions">
    <a class="btn btn-primary" href={site.resumePdf ?? '/resume'} data-ga-event="resume_download" data-ga-location="hero">
      <Icon name="download" />
      <span>{resumeIsPdf ? 'Download resume (PDF)' : 'Read my resume'}</span>
    </a>
    <a class="btn btn-ghost" href={`mailto:${site.email}`} data-ga-event="contact_click" data-ga-method="email">Email me</a>
  </div>
  <div class="chevron" aria-hidden="true">
    {bands.map((band) => <span class="band" style={`background: var(--rv-${band})`} />)}
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
    gap: 32px;
    padding: 40px;
  }
  /* In light mode the hero stays a night plate, per the design. */
  :global([data-theme='light']) .hero { background: var(--rv-void); border-color: var(--rv-void); }
  .copy { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 20px; max-width: 600px; }
  h1 {
    font-family: var(--font-display);
    font-weight: var(--type-display-xl-weight);
    font-size: clamp(48px, 6vw, var(--type-display-xl-size));
    line-height: var(--type-display-xl-line);
    letter-spacing: var(--type-display-xl-tracking);
  }
  .lede { font-size: var(--type-lede-size); line-height: var(--type-lede-line); text-wrap: pretty; }
  .actions { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: var(--space-16); }

  .chevron { position: absolute; right: -24px; bottom: -32px; display: none; }
  .band {
    width: 144px;
    height: 240px;
    clip-path: polygon(0 0, 48px 0, 144px 120px, 48px 240px, 0 240px, 96px 120px);
    animation:
      band-in 200ms cubic-bezier(0.3, 1.5, 0.6, 1) both,
      band-nudge 7s ease-in-out infinite;
  }
  .band + .band { margin-left: -96px; }
  .band:nth-child(1) { animation-delay: 0ms, 1200ms; }
  .band:nth-child(2) { animation-delay: 60ms, 1290ms; }
  .band:nth-child(3) { animation-delay: 120ms, 1380ms; }
  .band:nth-child(4) { animation-delay: 180ms, 1470ms; }
  .band:nth-child(5) { animation-delay: 240ms, 1560ms; }
  @keyframes band-in {
    from { transform: translateX(-24px); opacity: 0; }
    70% { transform: translateX(3px); }
    to { transform: none; }
  }
  @keyframes band-nudge {
    0%, 86%, 100% { transform: none; }
    92% { transform: translateX(6px); }
  }

  /* The chevron only fits once the copy column can stay clear of it. */
  @container (min-width: 780px) {
    .copy { max-width: 420px; }
    h1 { white-space: nowrap; }
    .chevron { display: flex; }
  }

  @media (max-width: 680px) {
    .hero { padding: var(--space-24); gap: var(--space-24); }
    .lede { font-size: 19px; line-height: 28px; }
    .actions { flex-direction: column; gap: 12px; }
  }
</style>
