<!-- Shows what's playing; deliberately not a link, so it opens nothing. -->
<div class="tile spotify" role="group" data-spotify data-state="loading" aria-label="Loading what Ry is listening to">
  <div class="art" aria-hidden="true" data-sp-art></div>
  <span class="badge">
    <span class="hud tile-label" data-sp-label>Listening</span>
    <span class="eq" aria-hidden="true"><span></span><span></span><span></span></span>
  </span>
  <span class="plate">
    <span class="sweep" aria-hidden="true" data-sp-sweep></span>
    <span class="track" data-sp-title>Tuning in</span>
    <span class="caption artist" data-sp-artist-box><span class="marquee" data-sp-artist>One moment</span></span>
  </span>
</div>

<script>
  import type { NowPlaying } from '../../lib/spotify';

  const tile = document.querySelector<HTMLElement>('[data-spotify]');
  const POLL_MS = 60_000;
  const MARQUEE_SPEED = 30; // px per second
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  // A line that doesn't fit scrolls back and forth instead of ending in an
  // ellipsis. Under reduced motion it keeps the ellipsis.
  // Titles always show in full. Long ones step down from 15px to 13px to
  // stay within three lines; anything longer still wraps in full and the
  // plate grows up over the album art.
  const TITLE_STEPS = [15, 14, 13] as const;
  const fitTitle = (title: HTMLElement) => {
    for (const size of TITLE_STEPS) {
      title.dataset.fit = String(size);
      const lineHeight = parseFloat(getComputedStyle(title).lineHeight);
      if (Math.round(title.offsetHeight / lineHeight) <= 3) return;
    }
  };

  const fitMarquee = (box: HTMLElement) => {
    box.classList.remove('is-marquee');
    const overflow = box.scrollWidth - box.clientWidth;
    if (overflow <= 1 || reducedMotion.matches) return;
    const distance = overflow + 8;
    // The scroll takes 60% of each leg; the rest is a pause at either end.
    const seconds = Math.max(3, distance / MARQUEE_SPEED / 0.6);
    box.style.setProperty('--marquee-distance', `${distance}px`);
    box.style.setProperty('--marquee-duration', `${seconds.toFixed(2)}s`);
    box.classList.add('is-marquee');
  };

  const ago = (iso: string) => {
    const minutes = Math.round((Date.now() - Date.parse(iso)) / 60_000);
    const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto', style: 'narrow' });
    if (minutes < 60) return rtf.format(-Math.max(minutes, 1), 'minute');
    if (minutes < 60 * 24) return rtf.format(-Math.round(minutes / 60), 'hour');
    return rtf.format(-Math.round(minutes / (60 * 24)), 'day');
  };

  // A song change: the old title and artist drift up and out, the new cover
  // fades in over the old one once it has loaded, the new text rises in, and
  // a thin spectrum line sweeps across the plate. Only when the track really
  // changes, never on a poll that finds the same one, and never under
  // reduced motion.
  const EASE_OUT = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
  const animate = () => !reducedMotion.matches;

  // Shows a cover, fading it in over the one before, then drops the old one.
  // Resolves once the new cover is ready to show.
  const showArt = async (box: HTMLElement, src: string | null, fade: boolean) => {
    const current = box.querySelector<HTMLImageElement>('img:last-child');
    if (!src) {
      // No cover (nothing playing, or a track without art): fade the old one out.
      const clear = () => box.replaceChildren();
      if (!fade || !current) return clear();
      current.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 360, easing: 'ease-out', fill: 'forwards' }).finished.then(clear, clear);
      return;
    }
    if (current?.src === src) return;
    const img = new Image(640, 640);
    img.alt = '';
    img.decoding = 'async';
    img.src = src;
    try {
      await img.decode();
    } catch {
      return;
    }
    box.append(img);
    const drop = () => [...box.querySelectorAll('img')].filter((other) => other !== img).forEach((other) => other.remove());
    if (!fade) return drop();
    img
      .animate([{ opacity: 0, transform: 'scale(1.06)' }, { opacity: 1, transform: 'none' }], { duration: 560, easing: EASE_OUT })
      .finished.then(drop, drop);
  };

  const render = async (el: HTMLElement, data: NowPlaying) => {
    const $ = <T extends HTMLElement>(sel: string) => el.querySelector<T>(sel)!;
    const title = $('[data-sp-title]');
    const artistBox = $('[data-sp-artist-box]');
    const key = data.state === 'off' ? 'off' : `${data.title}\u0000${data.artist}`;
    const changed = el.dataset.track !== undefined && el.dataset.track !== key;
    const firstLoad = el.dataset.track === undefined;
    el.dataset.track = key;
    const motion = changed && animate();

    const label = data.state === 'off' ? 'Listening' : data.state === 'playing' ? 'Now playing' : `Last played · ${ago(data.at)}`;
    const text = data.state === 'off' ? { title: 'Quiet right now', artist: 'Nothing on the speakers' } : data;
    const art = showArt($('[data-sp-art]'), data.state === 'off' ? null : data.art, motion || (firstLoad && animate()));

    // Old text out while the new cover loads.
    const parts = [title, artistBox];
    const outs = motion
      ? parts.map((part) => part.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'translateY(-4px)' }], { duration: 180, easing: 'ease-in', fill: 'forwards' }))
      : [];
    await Promise.all([art, ...outs.map((out) => out.finished.catch(() => {}))]);

    el.dataset.state = data.state;
    $('[data-sp-label]').textContent = label;
    title.textContent = text.title;
    $('[data-sp-artist]').textContent = text.artist;
    fitTitle(title);
    fitMarquee(artistBox);
    el.setAttribute('aria-label', data.state === 'off' ? 'Nothing playing right now' : `${label}: ${data.title} by ${data.artist}`);

    if (!motion) return;
    outs.forEach((out) => out.cancel());
    parts.forEach((part, i) =>
      part.animate([{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: 320, delay: i * 70, easing: EASE_OUT, fill: 'backwards' }),
    );
    $('[data-sp-sweep]').animate(
      [
        { transform: 'scaleX(0)', opacity: 1 },
        { transform: 'scaleX(1)', opacity: 1, offset: 0.55 },
        { transform: 'scaleX(1)', opacity: 0 },
      ],
      { duration: 1100, easing: EASE_OUT },
    );
  };

  const refresh = async () => {
    if (!tile || document.hidden) return;
    try {
      const res = await fetch('/api/now-playing', { headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      await render(tile, (await res.json()) as NowPlaying);
    } catch {
      if (tile.dataset.state === 'loading') await render(tile, { state: 'off' });
    }
  };

  if (tile) {
    // Re-fit when the tile changes width (window resize, a tile drag) or the
    // web font swaps in and changes the text width. The artist box spans the
    // plate's full width, so it tracks width changes for both lines.
    const box = tile.querySelector<HTMLElement>('[data-sp-artist-box]')!;
    const title = tile.querySelector<HTMLElement>('[data-sp-title]')!;
    let lastWidth = 0;
    new ResizeObserver(([entry]) => {
      const width = entry!.contentRect.width;
      if (width === lastWidth) return;
      lastWidth = width;
      fitTitle(title);
      fitMarquee(box);
    }).observe(box);
    document.fonts.ready.then(() => {
      fitTitle(title);
      fitMarquee(box);
    });
    reducedMotion.addEventListener('change', () => fitMarquee(box));
    refresh();
    setInterval(refresh, POLL_MS);
    document.addEventListener('visibilitychange', refresh);
  }
</script>

<style>
  /* contain: size keeps a tall title from stretching the grid row; the
     tile takes its height from its neighbours and the plate grows inside it. */
  .spotify { overflow: hidden; padding: 12px; justify-content: flex-end; contain: size; }
  .art {
    position: absolute;
    inset: 0;
    background: var(--color-panel-sunk);
    border-radius: inherit;
    overflow: hidden;
  }
  /* Covers stack so a new one can fade in over the old. */
  .art :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .badge {
    position: absolute;
    top: 12px;
    left: 12px;
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    max-width: calc(100% - 24px);
    padding: 6px var(--space-8);
    background: var(--color-bg);
    border-radius: var(--radius-sm);
  }
  .badge .tile-label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .eq { display: none; align-items: flex-end; gap: 2px; height: 12px; }
  .eq > span { width: 3px; height: 12px; background: var(--color-hud); transform-origin: bottom; animation: eq 900ms ease-in-out infinite; }
  .eq > span:nth-child(2) { animation-delay: -300ms; }
  .eq > span:nth-child(3) { animation-delay: -600ms; }
  [data-state='playing'] .eq { display: inline-flex; }
  @keyframes eq {
    0%, 100% { transform: scaleY(0.35); }
    50% { transform: scaleY(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .eq > span { animation: none; transform: scaleY(0.6); }
  }

  .plate {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    padding: 10px 12px;
    background: var(--color-bg);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  /* The spectrum line that sweeps across the plate when the song changes. */
  .sweep {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, var(--rv-pink), var(--rv-tangerine), var(--rv-lime), var(--rv-cyan), var(--rv-violet));
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
  }
  :global([data-theme='light']) .plate { background: var(--color-panel); border: 1px solid var(--color-hairline); }
  .track {
    font-weight: 700;
    font-size: 15px;
    line-height: 20px;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .track[data-fit='14'] { font-size: 14px; line-height: 19px; }
  .track[data-fit='13'] { font-size: 13px; line-height: 18px; }
  .artist { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* Inline by default so text-overflow can ellipsize it; inline-block only
     while scrolling, since transforms don't apply to inline boxes. */
  .artist.is-marquee { text-overflow: clip; }
  .is-marquee .marquee {
    display: inline-block;
    animation: marquee var(--marquee-duration) ease-in-out infinite alternate;
  }
  @keyframes marquee {
    0%, 20% { transform: none; }
    80%, 100% { transform: translateX(calc(-1 * var(--marquee-distance))); }
  }
  [data-state='loading'] .track { color: var(--color-ink-muted); }
  @media (max-width: 680px) {
    .spotify { min-height: 200px; }
  }
</style>
