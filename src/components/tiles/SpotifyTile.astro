---
import { site } from '../../data/site';
---

<a class="tile spotify" href={site.spotifyProfile} data-spotify data-state="loading" aria-label="Spotify: loading what Ry is listening to">
  <div class="art" aria-hidden="true">
    <img alt="" width="640" height="640" decoding="async" hidden data-sp-art />
  </div>
  <span class="badge">
    <span class="hud tile-label" data-sp-label>Spotify</span>
    <span class="eq" aria-hidden="true"><span></span><span></span><span></span></span>
  </span>
  <span class="plate">
    <span class="track" data-sp-title>Tuning in</span>
    <span class="caption artist" data-sp-artist>Spotify</span>
  </span>
</a>

<script>
  import type { NowPlaying } from '../../lib/spotify';

  const tile = document.querySelector<HTMLAnchorElement>('[data-spotify]');
  const POLL_MS = 60_000;

  const ago = (iso: string) => {
    const minutes = Math.round((Date.now() - Date.parse(iso)) / 60_000);
    const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto', style: 'narrow' });
    if (minutes < 60) return rtf.format(-Math.max(minutes, 1), 'minute');
    if (minutes < 60 * 24) return rtf.format(-Math.round(minutes / 60), 'hour');
    return rtf.format(-Math.round(minutes / (60 * 24)), 'day');
  };

  const render = (el: HTMLAnchorElement, data: NowPlaying) => {
    const $ = <T extends HTMLElement>(sel: string) => el.querySelector<T>(sel)!;
    const art = $<HTMLImageElement>('[data-sp-art]');
    el.dataset.state = data.state;

    if (data.state === 'off') {
      $('[data-sp-label]').textContent = 'Spotify';
      $('[data-sp-title]').textContent = 'Quiet right now';
      $('[data-sp-artist]').textContent = 'Nothing on the speakers';
      el.setAttribute('aria-label', 'Spotify: nothing playing right now');
      art.hidden = true;
      return;
    }

    const label = data.state === 'playing' ? 'Now playing' : `Last played · ${ago(data.at)}`;
    $('[data-sp-label]').textContent = label;
    $('[data-sp-title]').textContent = data.title;
    $('[data-sp-artist]').textContent = `${data.artist} · Spotify`;
    el.href = data.url;
    el.setAttribute('aria-label', `${label}: ${data.title} by ${data.artist}. Open in Spotify`);
    if (data.art && art.src !== data.art) {
      art.onload = () => (art.hidden = false);
      art.src = data.art;
    } else if (!data.art) {
      art.hidden = true;
    }
  };

  const refresh = async () => {
    if (!tile || document.hidden) return;
    try {
      const res = await fetch('/api/now-playing', { headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      render(tile, (await res.json()) as NowPlaying);
    } catch {
      if (tile.dataset.state === 'loading') render(tile, { state: 'off' });
    }
  };

  if (tile) {
    refresh();
    setInterval(refresh, POLL_MS);
    document.addEventListener('visibilitychange', refresh);
  }
</script>

<style>
  .spotify { overflow: hidden; padding: 12px; }
  .art {
    position: absolute;
    inset: 0;
    background: var(--color-panel-sunk);
    border-radius: inherit;
    overflow: hidden;
  }
  .art img { width: 100%; height: 100%; object-fit: cover; animation: art-in 240ms ease-out; }
  @keyframes art-in { from { opacity: 0; transform: scale(1.04); } }

  .badge {
    position: relative;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    max-width: 100%;
    padding: 6px var(--space-8);
    background: var(--color-bg);
    border-radius: var(--radius-sm);
  }
  .badge .tile-label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .eq { display: none; align-items: flex-end; gap: 2px; height: 12px; }
  .eq > span { width: 3px; height: 12px; background: var(--color-hud); transform-origin: bottom; animation: eq 900ms ease-in-out infinite; }
  .eq > span:nth-child(2) { animation-delay: -300ms; }
  .eq > span:nth-child(3) { animation-delay: -600ms; }
  [data-state='playing'] .eq { display: inline-flex; }
  @keyframes eq {
    0%, 100% { transform: scaleY(0.35); }
    50% { transform: scaleY(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .eq > span { animation: none; transform: scaleY(0.6); }
  }

  .plate {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    padding: 10px 12px;
    background: var(--color-bg);
    border-radius: var(--radius-sm);
  }
  :global([data-theme='light']) .plate { background: var(--color-panel); border: 1px solid var(--color-hairline); }
  .track {
    font-weight: 700;
    font-size: 15px;
    line-height: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .artist { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  [data-state='loading'] .track { color: var(--color-ink-muted); }
  @media (max-width: 680px) {
    .spotify { min-height: 200px; }
  }
</style>
