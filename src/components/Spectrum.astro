---
const bands = ['pink', 'tangerine', 'lime', 'cyan', 'violet'];
---

<div class="spectrum" aria-hidden="true" data-spectrum>
  {bands.map((band) => <span style={`background: var(--rv-${band})`} />)}
</div>

<script>
  // The theme toggle sends one ripple down the stripe.
  const stripe = document.querySelector<HTMLElement>('[data-spectrum]');
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    if (!stripe) return;
    stripe.classList.remove('ripple');
    void stripe.offsetWidth; // restart the animation if it is mid-run
    stripe.classList.add('ripple');
  });
</script>

<style>
  .spectrum > span { transform-origin: left top; }
  /* The stagger lives in a variable: the animation shorthands below would
     otherwise reset animation-delay. */
  .spectrum > span:nth-child(2) { --delay: 60ms; }
  .spectrum > span:nth-child(3) { --delay: 120ms; }
  .spectrum > span:nth-child(4) { --delay: 180ms; }
  .spectrum > span:nth-child(5) { --delay: 240ms; }

  /* First page of a session: the bands snap in left to right with the hero
     chevron's timing, then one ripple runs through them as the chevron
     nudges. Base.astro sets data-intro once per session. */
  /* The overshoot is in the keyframes, so each segment just eases out. */
  :global(html[data-intro]) .spectrum > span {
    animation: stripe-intro 1600ms cubic-bezier(0.2, 0.8, 0.3, 1) var(--delay, 0ms) both;
  }
  /* Matches the intro rule's specificity and comes later, so it wins. */
  :global(html) .spectrum.ripple > span { animation: stripe-ripple 260ms cubic-bezier(0.2, 0.8, 0.3, 1) var(--delay, 0ms); }

  @keyframes stripe-intro {
    0% { scale: 0 1; }
    12% { scale: 1.06 1; }
    16%, 75% { scale: 1 1; }
    82% { scale: 1 1.75; }
    90%, 100% { scale: 1 1; }
  }
  @keyframes stripe-ripple {
    0%, 100% { scale: 1 1; }
    40% { scale: 1 1.75; }
  }

  @media (prefers-reduced-motion: reduce) {
    .spectrum > span { animation: none !important; }
  }
</style>
