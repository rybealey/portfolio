---
// A shared link, unfurled from its stored preview (link_previews). Picks
// one of the canvas states: large image, square summary, video, text only,
// or a plain link when the fetch failed or hasn't happened yet.
import type { NotePreview } from '../../lib/notes';

interface Props {
  url: string;
  preview?: NotePreview | undefined;
}

const { url, preview } = Astro.props;
const ok = preview?.status === 'ok' ? preview : null;
const host = preview?.host || new URL(url).hostname.replace(/^www\./, '');
const image = ok?.image;

type Variant = 'large' | 'summary' | 'video' | 'text' | 'plain';
let variant: Variant = 'plain';
if (ok && image) {
  if (ok.kind === 'video') variant = 'video';
  else if (ok.kind === 'summary' || (image.width && image.height && image.width / image.height < 1.3)) variant = 'summary';
  else variant = 'large';
} else if (ok?.title) {
  variant = 'text';
}
const pretty = url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

{
  variant === 'plain' ? (
    <a class="card plain" href={url}>
      <span class="hud muted">{host}</span>
      <span class="plain-url">{pretty}</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17L17 7M9 7h8v8" />
      </svg>
    </a>
  ) : variant === 'text' ? (
    <a class="card text" href={url}>
      <span class="glyph" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" />
          <path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" />
        </svg>
      </span>
      <span class="meta">
        <span class="hud host">{host}</span>
        <span class="lp-title">{ok!.title}</span>
        {ok!.description && <span class="desc">{ok!.description}</span>}
      </span>
    </a>
  ) : variant === 'summary' ? (
    <a class="card summary" href={url}>
      <img class="thumb" src={image!.src} alt="" width="240" height="240" loading="lazy" decoding="async" />
      <span class="meta">
        <span class="hud host">{host}</span>
        <span class="lp-title one-line">{ok!.title ?? pretty}</span>
        {ok!.description && <span class="desc one-line">{ok!.description}</span>}
      </span>
    </a>
  ) : (
    <a class="card large" href={url}>
      <span class="media">
        <img src={image!.src} alt="" width={image!.width ?? 1200} height={image!.height ?? 630} loading="lazy" decoding="async" />
        {variant === 'video' && (
          <span class="play" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5.5v13l11-6.5z" />
            </svg>
          </span>
        )}
      </span>
      <span class="meta">
        <span class="hud host">{variant === 'video' && ok!.siteName ? `${host} · ${ok!.siteName}` : host}</span>
        <span class="lp-title">{ok!.title ?? pretty}</span>
        {ok!.description && <span class="desc">{ok!.description}</span>}
      </span>
    </a>
  )
}

<style>
  .card {
    display: flex;
    color: var(--color-ink);
    text-decoration: none;
    background: var(--color-panel);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition:
      transform 160ms cubic-bezier(0.3, 1.5, 0.6, 1),
      box-shadow 160ms,
      border-color 160ms;
  }
  .card:hover,
  .card:focus-visible {
    color: var(--color-ink);
    transform: translateY(-2px);
    border-color: var(--color-ink-muted);
    box-shadow: 4px 4px 0 0 var(--color-pop);
  }
  .meta { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .host { color: var(--color-ink-muted); font-size: 11px; line-height: 14px; }
  .lp-title { font-weight: 700; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .desc { font-size: 14px; line-height: 20px; color: var(--color-ink-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .one-line { display: block; white-space: nowrap; text-overflow: ellipsis; }

  .large { flex-direction: column; }
  .large .meta { padding: 14px 16px 16px; border-top: 1px solid var(--color-hairline); }
  .media { position: relative; display: block; aspect-ratio: 1.91 / 1; background: var(--color-panel-sunk); }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-pill);
    display: grid;
    place-items: center;
    background: var(--rv-pink);
    color: var(--rv-void);
    box-shadow: 4px 4px 0 0 var(--rv-lime);
  }

  .summary { display: grid; grid-template-columns: 120px minmax(0, 1fr); }
  .summary :global(.thumb) { width: 120px; height: 100%; min-height: 120px; object-fit: cover; border-right: 1px solid var(--color-hairline); }
  .summary .meta { padding: 14px 16px; justify-content: center; }

  .text { padding: var(--space-16); gap: 14px; align-items: flex-start; }
  .glyph { flex: none; width: 40px; height: 40px; border-radius: var(--radius-sm); display: grid; place-items: center; background: var(--color-panel-sunk); color: var(--color-ink-muted); }

  .plain {
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 14px 16px;
    background: transparent;
    border-style: dashed;
  }
  .plain .muted { font-size: 11px; line-height: 14px; }
  .plain-url { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--color-link); text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 680px) {
    .summary { grid-template-columns: 88px minmax(0, 1fr); }
    .summary :global(.thumb) { width: 88px; min-height: 88px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card { transition: none; }
    .card:hover, .card:focus-visible { transform: none; }
  }
</style>
