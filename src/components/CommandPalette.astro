---
import { getCaseStudies } from '../lib/work';
import Icon from './Icon.astro';
import { site } from '../data/site';

const work = await getCaseStudies();

type Item = { label: string; meta: string; href?: string; action?: 'theme' | 'reset-layout' };

const items: Item[] = [
  ...work.map((entry) => ({
    label: entry.data.title,
    meta: `0${entry.data.order} · ${entry.data.label}`,
    href: `/work/${entry.id}`,
  })),
  { label: 'Home', meta: 'Page', href: '/' },
  { label: 'About', meta: 'Page', href: '/about' },
  { label: 'Resume', meta: 'Page', href: site.resumePdf ?? '/resume' },
  { label: 'Writing', meta: 'Page', href: '/writing' },
  { label: 'Colophon', meta: 'Page', href: '/colophon' },
  { label: 'Email Ry', meta: 'Contact', href: `mailto:${site.email}` },
  { label: 'LinkedIn', meta: 'Contact', href: site.linkedin },
  { label: 'Switch light or dark mode', meta: 'Action', action: 'theme' },
  { label: 'Reset the home layout', meta: 'Action', action: 'reset-layout' },
];
---

<dialog class="cmdk" aria-label="Command palette" data-cmdk>
  <div class="search">
    <Icon name="search" />
    <label for="cmdk-input" class="visually-hidden">Jump to a page or section</label>
    <input
      id="cmdk-input"
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="cmdk-list"
      aria-autocomplete="list"
      autocomplete="off"
      spellcheck="false"
      placeholder="Jump to a page or section"
    />
    <kbd class="hud muted">ESC</kbd>
  </div>
  <ul id="cmdk-list" role="listbox" aria-label="Results">
    {
      items.map((item, i) => (
        <li
          role="option"
          id={`cmdk-opt-${i}`}
          aria-selected="false"
          data-href={item.href}
          data-action={item.action}
          data-search={`${item.label} ${item.meta}`.toLowerCase()}
        >
          <span>{item.label}</span>
          <span class="hud">{item.meta}</span>
        </li>
      ))
    }
  </ul>
  <p class="empty caption" hidden>Nothing matches that yet.</p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-cmdk]')!;
  const input = dialog.querySelector<HTMLInputElement>('input')!;
  const options = [...dialog.querySelectorAll<HTMLLIElement>('[role="option"]')];
  const empty = dialog.querySelector<HTMLParagraphElement>('.empty')!;
  let active = 0;

  const visible = () => options.filter((o) => !o.hidden);

  const setActive = (index: number) => {
    options.forEach((o) => o.setAttribute('aria-selected', 'false'));
    const list = visible();
    if (!list.length) {
      input.removeAttribute('aria-activedescendant');
      return;
    }
    active = (index + list.length) % list.length;
    const current = list[active]!;
    current.setAttribute('aria-selected', 'true');
    input.setAttribute('aria-activedescendant', current.id);
    current.scrollIntoView({ block: 'nearest' });
  };

  const filter = () => {
    const query = input.value.trim().toLowerCase();
    for (const o of options) o.hidden = !!query && !o.dataset.search!.includes(query);
    empty.hidden = visible().length > 0;
    setActive(0);
  };

  const open = (trigger: 'keyboard' | 'button') => {
    if (dialog.open) return;
    input.value = '';
    filter();
    dialog.showModal();
    input.focus();
    document.dispatchEvent(new CustomEvent('cmdk:open', { detail: { trigger } }));
  };

  const run = (option: HTMLLIElement) => {
    dialog.close();
    const { href, action } = option.dataset;
    if (href) window.location.href = href;
    else if (action === 'theme') document.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.click();
    else if (action === 'reset-layout') {
      if (document.querySelector('[data-bento]')) document.dispatchEvent(new CustomEvent('bento:reset'));
      else {
        try {
          localStorage.removeItem('rb:bento');
        } catch {}
        window.location.href = '/';
      }
    }
  };

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      if (dialog.open) dialog.close();
      else open('keyboard');
    }
  });
  document.querySelectorAll('[data-cmdk-open]').forEach((button) => button.addEventListener('click', () => open('button')));

  input.addEventListener('input', filter);
  input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      setActive(active + 1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      setActive(active - 1);
    } else if (event.key === 'Enter') {
      const current = visible()[active];
      if (current) run(current);
    }
  });
  for (const o of options) {
    o.addEventListener('click', () => run(o));
    o.addEventListener('pointermove', () => setActive(visible().indexOf(o)));
  }
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  .cmdk {
    width: min(560px, calc(100vw - 32px));
    margin: 12vh auto auto;
    padding: 0;
    background: var(--color-panel);
    color: var(--color-ink);
    border: 2px solid var(--color-ink-muted);
    border-radius: 12px;
    box-shadow: 4px 4px 0 0 var(--rv-pink);
    overflow: hidden;
  }
  .cmdk::backdrop { background: rgb(13 7 24 / 0.72); }
  .search {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px var(--space-16);
    border-bottom: 1px solid var(--color-hairline);
    color: var(--color-ink-muted);
  }
  input {
    flex: 1;
    min-width: 0;
    min-height: 32px;
    background: transparent;
    border: 0;
    color: var(--color-ink);
  }
  input:focus-visible { outline: none; }
  input::placeholder { color: var(--color-ink-muted); }
  kbd { font-family: var(--font-mono); }
  ul { max-height: min(360px, 50vh); overflow-y: auto; margin: 0; padding: var(--space-8); list-style: none; }
  li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    color: var(--color-ink-muted);
    cursor: pointer;
  }
  li[hidden] { display: none; }
  li .hud { flex: none; }
  li[aria-selected='true'] { background: var(--color-bg); color: var(--color-ink); }
  li[aria-selected='true'] .hud { color: var(--color-hud); }
  .empty { padding: 0 var(--space-24) var(--space-16); }
</style>
