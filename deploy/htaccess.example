# Rules to add to the .htaccess in ryanbealey.com's document root, ABOVE the
# block cPanel writes for the Node.js app. Leave cPanel's block alone: it is
# rewritten whenever the app is edited in Setup Node.js App.
#
# For reference, cPanel's block looks like this (paths will differ):
#
#   # DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
#   PassengerAppRoot "/home/USER/ryanbealey"
#   PassengerBaseURI "/"
#   PassengerNodejs "/home/USER/nodevenv/ryanbealey/24/bin/node"
#   PassengerAppType node
#   PassengerStartupFile app.cjs
#   # DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# Never show Passenger's debug page (it can print environment variables).
PassengerFriendlyErrorPages off

# HTTPS and the bare domain only.
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://ryanbealey.com%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
