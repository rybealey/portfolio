{
  "name": "ryanbealey.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run tokens && astro dev",
    "build": "npm run tokens && node scripts/astro-build.mjs",
    "preview": "node --env-file-if-exists=.env app.cjs",
    "check": "astro check",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/db-seed.mjs",
    "db:previews": "node --env-file-if-exists=.env scripts/db-previews.mjs",
    "api:token": "node --env-file-if-exists=.env scripts/api-token.mjs",
    "spotify:auth": "node --env-file-if-exists=.env scripts/spotify-auth.mjs",
    "resume:pdf": "node scripts/resume-pdf.mjs",
    "package": "npm run tokens && astro check && node scripts/astro-build.mjs && node scripts/package-release.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/rss": "^4.0.19",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.2",
    "marked": "^18.1.2",
    "mysql2": "^3.24.6",
    "satori": "^0.63.2",
    "shiki": "^4.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.0"
  }
}
