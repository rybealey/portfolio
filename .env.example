# Spotify "now playing" tile. Run `npm run spotify:auth` once to get the
# refresh token. On cPanel, set these in Setup Node.js App > Environment
# variables instead of uploading a .env file.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# MariaDB. Locally: the Docker database from docker-compose.yml, so pick any
# passwords. On cPanel: the database and user from MySQL Databases, with
# DB_HOST=localhost and DB_PORT=3306, set in Setup Node.js App.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=ryanbealey
DB_USER=ryanbealey
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Contact form email, through SMTP2Go's API (optional). Without these, messages
# are still saved to the contact_messages table. CONTACT_FROM must be a sender
# verified in SMTP2Go, e.g. "ryanbealey.com <contact@ryanbealey.com>";
# CONTACT_TO is where messages go.
SMTP2GO_API_KEY=
CONTACT_TO=
CONTACT_FROM=
